                          "id":  6,
                          "questionText":  "A functional dependency is written as:",
                          "optionA":  "X → Y",
                          "optionB":  "X = Y",
                          "optionC":  "X + Y",
                          "optionD":  "X / Y",
                          "optionE":  "",
                          "correctAnswer":  "A",
                          "explanation":  "X → Y means X functionally determines Y."
                      },
                      {
                          "id":  7,
                          "questionText":  "In X → Y, X is called the:",
                          "optionA":  "Determinant",
                          "optionB":  "Dependent only",
                          "optionC":  "Tuple",
                          "optionD":  "Domain",
                          "optionE":  "",
                          "correctAnswer":  "A",
                          "explanation":  "X is the determinant of the dependency."
                      },
                      {
                          "id":  8,
                          "questionText":  "In X → Y, Y is called the:",
                          "optionA":  "Dependent",
                          "optionB":  "Determinant",
                          "optionC":  "Candidate key",
                          "optionD":  "Relation",
                          "optionE":  "",
                          "correctAnswer":  "A",
                          "explanation":  "Y is functionally dependent on X."
                      },
                      {
                          "id":  9,
                          "questionText":  "A trivial functional dependency has:",
                          "optionA":  "Y as a subset of X",
                          "optionB":  "X as a subset of Y only",
                          "optionC":  "No attributes",
                          "optionD":  "Only one tuple",
                          "optionE":  "",
                          "correctAnswer":  "A",
                          "explanation":  "A dependency X → Y is trivial when Y is a subset of X."
                      },
                      {
                          "id":  10,
                          "questionText":  "Which anomaly occurs when insertion cannot be performed without unrelated data?",
                          "optionA":  "Insertion anomaly",
                          "optionB":  "Deletion anomaly",
                          "optionC":  "Update anomaly",
                          "optionD":  "Join anomaly",
                          "optionE":  "",
                          "correctAnswer":  "A",
                          "explanation":  "Insertion anomaly occurs when necessary data cannot be added independently."
                      },
                      {
                          "id":  11,
                          "questionText":  "Which anomaly can cause unintended loss of information when deleting a row?",
                          "optionA":  "Deletion anomaly",
                          "optionB":  "Insertion anomaly",
                          "optionC":  "Update anomaly",
                          "optionD":  "Selection anomaly",
                          "optionE":  "",
                          "correctAnswer":  "A",
                          "explanation":  "Deletion anomaly occurs when deleting one fact unintentionally removes another fact."
                      },
                      {
                          "id":  12,

<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================================================ -->
        <!-- Main Disclaimer Card -->
        <!-- ================================================ -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disclaimer"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="42dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="7dp"
                    android:background="@color/primary_blue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="CS Teacher Prep"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <!-- ======================================== -->
                <!-- Educational Purpose -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Educational Purpose"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="CS Teacher Prep is developed for educational and examination preparation purposes. The app provides practice questions and study resources to support learners."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- No Guarantee of Examination Result -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="No Guarantee of Examination Result"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Use of the app does not guarantee selection, qualification, marks or any particular result in Bihar STET, BPSC PGT or any other examination."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- Question Accuracy -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Question Accuracy"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Reasonable efforts are made to provide useful and accurate study content. However, questions, explanations or other educational content may contain errors or omissions.

Users should verify important examination-related information with official sources and notifications."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- Official Information -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Official Information"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="For application dates, eligibility, syllabus, examination pattern, admit cards, results and other official matters, users should rely on information published by the relevant official examination authority."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- Independent Application -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Independent Application"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="CS Teacher Prep is an independent educational application. It is not an official application of Bihar STET, BPSC or any government department."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- External Links -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="External Links &amp; Services"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="The app may provide links to external websites, social platforms, email services or other third-party services. The developer does not control and is not responsible for the content, availability or privacy practices of external services."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- Advertisements -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Advertisements"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="The app may display banner and rewarded advertisements. Advertisement availability and content may be controlled by third-party advertising services."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />


                <!-- ======================================== -->
                <!-- Acceptance -->
                <!-- ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Acceptance"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="2dp"
                    android:lineSpacingExtra="4dp"
                    android:text="By using CS Teacher Prep, users acknowledge that the application is intended as a supplementary educational and preparation resource and agree to use the information at their own discretion."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
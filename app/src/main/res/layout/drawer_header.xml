<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="215dp"
    android:background="@drawable/drawer_header_background">


    <!-- Decorative Glow -->

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-55dp"
        android:layout_marginEnd="-45dp"
        android:background="@drawable/drawer_header_glow" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="18dp">


        <!-- ================================================= -->
        <!-- Logo Card -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="78dp"
            android:layout_height="78dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="4dp"
            app:strokeColor="#66FFFFFF"
            app:strokeWidth="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ImageView
                android:id="@+id/drawerLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:src="@drawable/cs_teacher_prep_logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- App Name -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textColor="@color/primary_blue_dark"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- Subtitle -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Computer Science Preparation App"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />


        <!-- ================================================= -->
        <!-- Exam Badge -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/drawer_exam_badge"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="Bihar STET  •  BPSC PGT"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>